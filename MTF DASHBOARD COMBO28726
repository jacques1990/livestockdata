// Runs inside each request.security() call and builds the opening range
// beginning at 6:00 PM America/New_York.
// The request uses the selected ORB timeframe instead of always loading
// 1-minute history. This is much lighter on TradingView memory.
f_orbCalc(sess) =>
    var float oHigh = na
    var float oLow  = na

    sessStart = timestamp("America/New_York", year, month, dayofmonth, 20, 00)
    sessEnd   = sessStart + sess * 60 * 1000
    inRange   = time >= sessStart and time < sessEnd
    newRange  = inRange and not inRange[1]

    if newRange
        oHigh := na
        oLow  := na

    if inRange
        oHigh := na(oHigh) ? high : math.max(oHigh, high)
        oLow  := na(oLow)  ? low  : math.min(oLow,  low)

    [oHigh, oLow, close]

f_orbStatusText(c, oh, ol) =>

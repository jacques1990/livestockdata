     request.security(
         orbSymSPY,
         "15",
         f_orbCalc(15),
         lookahead=barmerge.lookahead_off
     )

[alertQqqOH, alertQqqOL, alertQqqC] =
     request.security(
         orbSymQQQ,
         "15",
         f_orbCalc(15),
         lookahead=barmerge.lookahead_off
     )

[alertSpxOH, alertSpxOL, alertSpxC] =
     request.security(
         "SP:SPX",
         "15",
         f_orbCalc(15),
         lookahead=barmerge.lookahead_off
     )

// Make sure all three opening ranges have finished forming.
orbAlertReady =
     not na(alertSpyOH) and not na(alertSpyOL) and
     not na(alertQqqOH) and not na(alertQqqOL) and
     not na(alertSpxOH) and not na(alertSpxOL)

// All three markets beyond the upper side of their own ORB.
allThreeAboveORB =
     orbAlertReady and
     alertSpyC > alertSpyOH and
     alertQqqC > alertQqqOH and
     alertSpxC > alertSpxOH

// All three markets beyond the lower side of their own ORB.
allThreeBelowORB =
     orbAlertReady and
     alertSpyC < alertSpyOL and
     alertQqqC < alertQqqOL and
     alertSpxC < alertSpxOL

// Trigger only when the complete three-symbol confluence first becomes true.
// This prevents repeated alerts while all three remain outside the ORB.
bullOrbConfluence =
     allThreeAboveORB and not allThreeAboveORB[1]

bearOrbConfluence =
     allThreeBelowORB and not allThreeBelowORB[1]

// Alert conditions shown separately in TradingView's alert menu.
alertcondition(
     bullOrbConfluence,
     title="SPY + QQQ + SPX Bullish 15M ORB Confluence",
     message="BULLISH 15M ORB CONFLUENCE: SPY, QQQ and SPX are all above their own 15-minute ORB highs."
)

alertcondition(
     bearOrbConfluence,
     title="SPY + QQQ + SPX Bearish 15M ORB Confluence",
     message="BEARISH 15M ORB CONFLUENCE: SPY, QQQ and SPX are all below their own 15-minute ORB lows."
)

// One combined alert option with prices and ORB levels.
if bullOrbConfluence
    alert(
         "BULLISH 15M ORB CONFLUENCE | " +
         "SPY: " + str.tostring(alertSpyC) +
         " > " + str.tostring(alertSpyOH) +
         " | QQQ: " + str.tostring(alertQqqC) +
         " > " + str.tostring(alertQqqOH) +
         " | SPX: " + str.tostring(alertSpxC) +
         " > " + str.tostring(alertSpxOH),
         alert.freq_once_per_bar
     )

if bearOrbConfluence
    alert(
         "BEARISH 15M ORB CONFLUENCE | " +
         "SPY: " + str.tostring(alertSpyC) +
         " < " + str.tostring(alertSpyOL) +
         " | QQQ: " + str.tostring(alertQqqC) +
         " < " + str.tostring(alertQqqOL) +
         " | SPX: " + str.tostring(alertSpxC) +
         " < " + str.tostring(alertSpxOL),
         alert.freq_once_per_bar
     )

//@version=6
indicator("MTF Dashboard + S/R Zones + EMA Angle System + FVG + ORB", overlay=true, max_lines_count=500, max_boxes_count=250, max_labels_count=200)

// ============================================================
//  SECTION 1 — INPUTS
// ============================================================

step = input.int(50, "Strike Step", group="MTF Dashboard")

pivotStrength = input.int(2,      "Pivot Strength",   group="S/R Zones")
zonePercent   = input.float(0.30, "Zone Width %",     group="S/R Zones")
extendBars    = input.int(80,     "Zone Extend Bars", group="S/R Zones")
maxSRZones    = input.int(10,     "Max S/R Zones (per side)", group="S/R Zones", minval=3, maxval=30)

emaFastLen    = input.int(9,      "EMA Fast Length",          group="EMA Angle")
emaSlowLen    = input.int(20,     "EMA Slow Length",          group="EMA Angle")
slopeLookback = input.int(6,      "Slope Lookback",           group="EMA Angle")
atrLen        = input.int(14,     "ATR Length",               group="EMA Angle")
minSlopeATR   = input.float(0.05, "Min Slope (ATR mult)",     group="EMA Angle", step=0.01)
cooldownBars  = input.int(8,      "Cooldown After EMA Cross", group="EMA Angle", minval=0)

fvgShowBull       = input.bool(true,        "Show Bullish FVG",                      group="Fair Value Gap")
fvgShowBear       = input.bool(true,        "Show Bearish FVG",                      group="Fair Value Gap")
fvgExtendBars     = input.int(150,          "Extend (bars)", minval=1, maxval=500,    group="Fair Value Gap")
fvgDeleteFill     = input.bool(true,        "Delete When Filled",                    group="Fair Value Gap")
fvgBullColor      = input.color(color.lime, "Bullish Zone Color",                    group="Fair Value Gap")
fvgBearColor      = input.color(color.red,  "Bearish Zone Color",                    group="Fair Value Gap")
fvgBullShadeTrans = input.int(85, "Bullish Transparency (0-100)", minval=0, maxval=100, group="Fair Value Gap")
fvgBearShadeTrans = input.int(85, "Bearish Transparency (0-100)", minval=0, maxval=100, group="Fair Value Gap")
fvgShowBorder     = input.bool(true,        "Show Zone Border",                      group="Fair Value Gap")
fvgBorderTrans    = input.int(40, "Border Transparency (0-100)",  minval=0, maxval=100, group="Fair Value Gap")
fvgMaxActive      = input.int(50, "Maximum Active FVGs (per side)", minval=5, maxval=100, group="Fair Value Gap")

rsiLen      = input.int(14, "RSI Length",           group="RSI State")
rsiOBLevel  = input.int(70, "Overbought Level",     group="RSI State")
rsiOSLevel  = input.int(30, "Oversold Level",       group="RSI State")
rsiBullZone = input.int(55, "Bullish Zone (above)", group="RSI State")
rsiBearZone = input.int(45, "Bearish Zone (below)", group="RSI State")

macdFastLen = input.int(12, "MACD Fast Length",   group="MACD State")
macdSlowLen = input.int(26, "MACD Slow Length",   group="MACD State")
macdSigLen  = input.int(9,  "MACD Signal Length", group="MACD State")

klShowDH    = input.bool(true,  "Show Daily High",         group="Key Levels")
klShowDL    = input.bool(true,  "Show Daily Low",          group="Key Levels")
klShowPDH   = input.bool(true,  "Show Prev Day High",      group="Key Levels")
klShowPDL   = input.bool(true,  "Show Prev Day Low",       group="Key Levels")
klShowWH    = input.bool(true,  "Show Weekly High",        group="Key Levels")
klShowWL    = input.bool(true,  "Show Weekly Low",         group="Key Levels")
klShowMH    = input.bool(true,  "Show Monthly High",       group="Key Levels")
klShowML    = input.bool(true,  "Show Monthly Low",        group="Key Levels")
klShow20H   = input.bool(true,  "Show 20D High",           group="Key Levels")
klShow20L   = input.bool(true,  "Show 20D Low",            group="Key Levels")
klShow30H   = input.bool(true,  "Show 30D High",           group="Key Levels")
klShow30L   = input.bool(true,  "Show 30D Low",            group="Key Levels")
klShow50H   = input.bool(true,  "Show 50D High",           group="Key Levels")
klShow50L   = input.bool(true,  "Show 50D Low",            group="Key Levels")
klExtend    = input.int(100,    "Label Extend (bars)",     group="Key Levels", minval=1)
klLabelStart = input.int(2,     "First Label Distance",    group="Key Levels", minval=0, maxval=50)
klLabelSpace = input.int(3,     "Space Between Labels",    group="Key Levels", minval=1, maxval=20)
klDHColor   = input.color(color.new(color.yellow,  0),  "Daily High/Low Color", group="Key Levels")
klPDColor   = input.color(color.new(color.orange,  0),  "Prev Day Color",       group="Key Levels")
klWColor    = input.color(color.new(color.aqua,    0),  "Weekly Color",         group="Key Levels")
klMColor    = input.color(color.new(color.fuchsia, 0),  "Monthly Color",        group="Key Levels")
kl20Color   = input.color(color.new(color.lime,    0),  "20D Range Color",      group="Key Levels")
kl30Color   = input.color(color.new(color.silver,  0),  "30D Range Color",      group="Key Levels")
kl50Color   = input.color(color.new(color.teal,    0),  "50D Range Color",      group="Key Levels")

// ---- ORB (Opening Range Breakout) Dashboard Inputs ----
orbPeriodSel = input.string("15 Min", "ORB Period", options=["5 Min", "15 Min", "30 Min", "1 Hour"], group="ORB Dashboard")
orbShowTable = input.bool(true, "Show ORB Table", group="ORB Dashboard")
orbTablePos  = input.string("Bottom Right", "Table Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group="ORB Dashboard")
orbTextSize  = input.string("Small", "Table Text Size", options=["Tiny", "Small", "Normal"], group="ORB Dashboard")

orbSymSPY   = input.symbol("SPY",   "Symbol 1 — Index",     group="ORB Dashboard")
orbSymQQQ   = input.symbol("QQQ",   "Symbol 2 — Index",     group="ORB Dashboard")
orbSymAAPL  = input.symbol("AAPL",  "Symbol 3 — Mag 7",     group="ORB Dashboard")
orbSymMSFT  = input.symbol("MSFT",  "Symbol 4 — Mag 7",     group="ORB Dashboard")
orbSymGOOGL = input.symbol("GOOGL", "Symbol 5 — Mag 7",     group="ORB Dashboard")
orbSymAMZN  = input.symbol("AMZN",  "Symbol 6 — Mag 7",     group="ORB Dashboard")
orbSymNVDA  = input.symbol("NVDA",  "Symbol 7 — Mag 7",     group="ORB Dashboard")
orbSymMETA  = input.symbol("META",  "Symbol 8 — Mag 7",     group="ORB Dashboard")
orbSymTSLA  = input.symbol("TSLA",  "Symbol 9 — Mag 7",     group="ORB Dashboard")

orbSymNQ    = input.symbol("CME_MINI:NQ1!",  "Symbol 10 — E-mini Nasdaq Futures", group="ORB Dashboard")
orbSymES    = input.symbol("CME_MINI:ES1!",  "Symbol 11 — E-mini S&P Futures",    group="ORB Dashboard")
orbSymYM    = input.symbol("CBOT_MINI:YM1!", "Symbol 12 — E-mini Dow Futures",    group="ORB Dashboard")
orbSymMNQ   = input.symbol("CME_MINI:MNQ1!", "Symbol 13 — Micro Nasdaq Futures",  group="ORB Dashboard")
orbSymMES   = input.symbol("CME_MINI:MES1!", "Symbol 14 — Micro S&P Futures",     group="ORB Dashboard")
orbSymMYM   = input.symbol("CBOT_MINI:MYM1!","Symbol 15 — Micro Dow Futures",     group="ORB Dashboard")

orbShowExtra = input.bool(false, "Show Extra Symbol (Optional)", group="ORB Dashboard")
orbSymExtra  = input.symbol("IWM", "Symbol 16 — Optional Extra", group="ORB Dashboard")

orbMinutes = orbPeriodSel == "5 Min" ? 5 : orbPeriodSel == "15 Min" ? 15 : orbPeriodSel == "30 Min" ? 30 : 60
orbCalcTf  = orbPeriodSel == "5 Min" ? "5" : orbPeriodSel == "15 Min" ? "15" : orbPeriodSel == "30 Min" ? "30" : "60"
orbTxtSize = orbTextSize == "Tiny" ? size.tiny : orbTextSize == "Normal" ? size.normal : size.small


// ============================================================
//  SECTION 2 — MTF SIGNAL FUNCTION
// ============================================================

_tfSignal() =>
    _e9   = ta.ema(close, 9)
    _e20  = ta.ema(close, 20)
    _e200 = ta.ema(close, 200)
    _rsi  = ta.rsi(close, 14)
    [_ml, _sl, _] = ta.macd(close, 12, 26, 9)
    _emaBull   = close > _e9  and _e9  > _e20
    _emaBear   = close < _e9  and _e9  < _e20
    _trendBull = close > _e200
    _trendBear = close < _e200
    _rsiBull   = _rsi > 55
    _rsiBear   = _rsi < 45
    _macdBull  = _ml > _sl
    _macdBear  = _ml < _sl
    _bull = (_emaBull ? 1 : 0) + (_trendBull ? 1 : 0) + (_rsiBull ? 1 : 0) + (_macdBull ? 1 : 0)
    _bear = (_emaBear ? 1 : 0) + (_trendBear ? 1 : 0) + (_rsiBear ? 1 : 0) + (_macdBear ? 1 : 0)
    _sig  = _bull >= 3 ? 1 : _bear >= 3 ? -1 : 0
    [_sig, math.max(_bull, _bear)]

[sig1m,  str1m]  = request.security(syminfo.tickerid, "1",  _tfSignal())
[sig3m,  str3m]  = request.security(syminfo.tickerid, "3",  _tfSignal())
[sig10m, str10m] = request.security(syminfo.tickerid, "10", _tfSignal())
[sig30m, str30m] = request.security(syminfo.tickerid, "30", _tfSignal())

alignedBull = sig1m == 1  and sig3m == 1  and sig10m == 1  and sig30m == 1
alignedBear = sig1m == -1 and sig3m == -1 and sig10m == -1 and sig30m == -1
avgStrength = (str1m + str3m + str10m + str30m) / 4.0

strikeType  = "NO TRADE"
strikeColor = color.gray

if alignedBull or alignedBear
    if avgStrength >= 3.5
        strikeType  := "DEEP ITM"
        strikeColor := color.purple
    else if avgStrength >= 3
        strikeType  := "ITM"
        strikeColor := color.blue
    else
        strikeType  := "ATM"
        strikeColor := color.green
else
    if str1m >= 3
        strikeType  := "ATM SCALP"
        strikeColor := color.yellow

atm         = math.round(close / step) * step
maxDistance = step * 1.2
callStrike  = atm
putStrike   = atm

if strikeType == "ITM"
    callStrike := math.abs(close - (atm - step))     <= maxDistance ? atm - step     : atm
    putStrike  := math.abs(close - (atm + step))     <= maxDistance ? atm + step     : atm

if strikeType == "DEEP ITM"
    callStrike := math.abs(close - (atm - 2 * step)) <= maxDistance ? atm - 2 * step : atm
    putStrike  := math.abs(close - (atm + 2 * step)) <= maxDistance ? atm + 2 * step : atm

direction   = alignedBull ? "CALL" : alignedBear ? "PUT" : "NONE"
finalStrike = "-"
if direction == "CALL"
    finalStrike := str.tostring(callStrike)
else if direction == "PUT"
    finalStrike := str.tostring(putStrike)


// ============================================================
//  SECTION 3 — CBC TREND
// ============================================================
var bool cbc = false
if bar_index > 0
    cbc := cbc[1]
if bar_index > 0
    if cbc and close < low[1]
        cbc := false
    if not cbc and close > high[1]
        cbc := true

cbcBull = cbc
cbcBear = not cbc

bgcolor(cbc and not cbc[1]  ? color.new(color.yellow, 75) :
        not cbc and cbc[1]  ? color.new(color.blue,   75) : na)

plotshape(not cbc and cbc[1], style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.small)
plotshape(cbc and not cbc[1], style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.small)


// ============================================================
//  SECTION 4 — EMA PLOTS + 200 EMA + VWAP
// ============================================================
emaFast  = ta.ema(close, emaFastLen)
emaSlow  = ta.ema(close, emaSlowLen)
ema200   = ta.ema(close, 200)
vwapVal  = ta.vwap(hlc3)

plot(emaFast,  "EMA Fast",  color=color.white,  linewidth=2)
plot(emaSlow,  "EMA Slow",  color=color.orange, linewidth=2)
plot(ema200,   "EMA 200",   color=color.yellow, linewidth=2)
plot(vwapVal,  "VWAP",      color=color.green,  linewidth=2)

ema200Above = close > ema200
vwapAbove   = close > vwapVal


// ============================================================
//  SECTION 5 — S/R ZONES
// ============================================================
ph = ta.pivothigh(high, pivotStrength, pivotStrength)
pl = ta.pivotlow(low,   pivotStrength, pivotStrength)

var float[] resAll = array.new_float()
var float[] supAll = array.new_float()
var line[]  rLines = array.new_line()
var line[]  sLines = array.new_line()
var box[]   rBoxes = array.new_box()
var box[]   sBoxes = array.new_box()

if not na(ph)
    array.push(resAll, ph)
    zone = ph * zonePercent / 100
    array.push(rBoxes, box.new(bar_index, ph + zone, bar_index + extendBars, ph - zone,
         bgcolor=color.new(color.red, 85), border_color=color.red))
    array.push(rLines, line.new(bar_index, ph, bar_index + extendBars, ph,
         color=color.red, width=2))
    if array.size(rBoxes) > maxSRZones
        box.delete(array.shift(rBoxes))
        line.delete(array.shift(rLines))
        array.shift(resAll)

if not na(pl)
    array.push(supAll, pl)
    zone = pl * zonePercent / 100
    array.push(sBoxes, box.new(bar_index, pl + zone, bar_index + extendBars, pl - zone,
         bgcolor=color.new(color.green, 85), border_color=color.green))
    array.push(sLines, line.new(bar_index, pl, bar_index + extendBars, pl,
         color=color.green, width=2))
    if array.size(sBoxes) > maxSRZones
        box.delete(array.shift(sBoxes))
        line.delete(array.shift(sLines))
        array.shift(supAll)

float rLevel = na
float sLevel = na

if array.size(resAll) > 0
    for i = 0 to array.size(resAll) - 1
        val = array.get(resAll, i)
        if val > close
            rLevel := na(rLevel) ? val : math.min(rLevel, val)

if array.size(supAll) > 0
    for i = 0 to array.size(supAll) - 1
        val = array.get(supAll, i)
        if val < close
            sLevel := na(sLevel) ? val : math.max(sLevel, val)


// ============================================================
//  SECTION 6 — EMA ANGLE SYSTEM
// ============================================================
atr       = ta.atr(atrLen)
slopeFast = (emaFast - emaFast[slopeLookback]) / atr
slopeSlow = (emaSlow - emaSlow[slopeLookback]) / atr

angledUp   = slopeFast >  minSlopeATR and slopeSlow >  minSlopeATR
angledDown = slopeFast < -minSlopeATR and slopeSlow < -minSlopeATR
flatEMAs   = not angledUp and not angledDown

emaCross = ta.cross(emaFast, emaSlow)

var int lastCrossBar = na
if emaCross
    lastCrossBar := bar_index

inCooldown = cooldownBars > 0 and not na(lastCrossBar) and (bar_index - lastCrossBar) <= cooldownBars
dontTrade  = flatEMAs or emaCross or inCooldown

isGreen   = close > open
isRed     = close < open
trendUp   = emaFast > emaSlow
trendDown = emaFast < emaSlow

longSignal  = (not dontTrade) and angledUp   and trendUp   and isGreen
shortSignal = (not dontTrade) and angledDown and trendDown and isRed
exLong      = (not dontTrade) and angledUp   and trendUp   and isRed
exShort     = (not dontTrade) and angledDown and trendDown and isGreen
exSignal    = exLong or exShort

var label dtLbl = na
var label lbLbl = na
var label lsLbl = na
var label exLbl = na

var bool prevDontTrade   = false
var bool prevLongSignal  = false
var bool prevShortSignal = false
var bool prevExSignal    = false

if barstate.isrealtime
    if dontTrade != prevDontTrade
        if dontTrade
            dtLbl := label.new(bar_index, high, "DT", style=label.style_label_down, color=color.gray, textcolor=color.white, size=size.tiny)
        else
            label.delete(dtLbl), dtLbl := na
        prevDontTrade := dontTrade
    else if dontTrade and not na(dtLbl)
        label.set_x(dtLbl, bar_index), label.set_y(dtLbl, high)

    if longSignal != prevLongSignal
        if longSignal
            lbLbl := label.new(bar_index, low, "LB", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
        else
            label.delete(lbLbl), lbLbl := na
        prevLongSignal := longSignal
    else if longSignal and not na(lbLbl)
        label.set_x(lbLbl, bar_index), label.set_y(lbLbl, low)

    if shortSignal != prevShortSignal
        if shortSignal
            lsLbl := label.new(bar_index, high, "LS", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
        else
            label.delete(lsLbl), lsLbl := na
        prevShortSignal := shortSignal
    else if shortSignal and not na(lsLbl)
        label.set_x(lsLbl, bar_index), label.set_y(lsLbl, high)

    if exSignal != prevExSignal
        exY   = exLong ? high : low
        exSty = exLong ? label.style_label_down : label.style_label_up
        if exSignal
            exLbl := label.new(bar_index, exY, "EX", style=exSty, color=color.orange, textcolor=color.white, size=size.tiny)
        else
            label.delete(exLbl), exLbl := na
        prevExSignal := exSignal
    else if exSignal and not na(exLbl)
        exY = exLong ? high : low
        exSty = exLong ? label.style_label_down : label.style_label_up
        label.set_x(exLbl, bar_index), label.set_y(exLbl, exY), label.set_style(exLbl, exSty)


// ============================================================
//  SECTION 7 — CBC + S/R ZONE ENTRY SIGNALS
// ============================================================
rng    = high - low
body   = math.abs(close - open)
upperW = high - math.max(open, close)
lowerW = math.min(open, close) - low

upperPct = rng > 0 ? upperW / rng : 0.0
lowerPct = rng > 0 ? lowerW / rng : 0.0
rangeOK  = rng >= syminfo.mintick * 3

touchSup = not na(sLevel) and low  <= sLevel
touchRes = not na(rLevel) and high >= rLevel

bullBody     = close > open and body > rng * 0.25
bearBody     = close < open and body > rng * 0.25
emaSlope     = emaFast - emaFast[1]
bullSlope    = emaSlope > 0
bearSlope    = emaSlope < 0
emaBullLocal = emaFast > emaSlow and close > emaFast
emaBearLocal = emaFast < emaSlow and close < emaFast

buySignal =
     rangeOK  and touchSup and
     lowerPct >= 0.45 and upperPct <= 0.25 and
     emaBullLocal and bullBody and bullSlope and cbcBull

sellSignal =
     rangeOK  and touchRes and
     upperPct >= 0.45 and lowerPct <= 0.25 and
     emaBearLocal and bearBody and bearSlope and cbcBear

var label entryLbl = na
if barstate.islast
    label.delete(entryLbl)
    if buySignal
        entryLbl := label.new(bar_index, low,  "B", style=label.style_label_up,   color=color.green, textcolor=color.white)
    else if sellSignal
        entryLbl := label.new(bar_index, high, "S", style=label.style_label_down, color=color.red,   textcolor=color.white)

alertcondition(buySignal,  "BUY",  "CBC + Support Bounce")
alertcondition(sellSignal, "SELL", "CBC + Resistance Rejection")


// ============================================================
//  SECTION 8 — FAIR VALUE GAP
// ============================================================
fvgBullFill   = color.new(fvgBullColor, fvgBullShadeTrans)
fvgBearFill   = color.new(fvgBearColor, fvgBearShadeTrans)
fvgBullBorder = fvgShowBorder ? color.new(fvgBullColor, fvgBorderTrans) : color.new(fvgBullColor, 100)
fvgBearBorder = fvgShowBorder ? color.new(fvgBearColor, fvgBorderTrans) : color.new(fvgBearColor, 100)

bullFVG = low  > high[2]
bearFVG = high < low[2]

var box[] fvgBullBoxes = array.new_box()
var box[] fvgBearBoxes = array.new_box()

if fvgShowBull and bullFVG
    b = box.new(bar_index - 2, low, bar_index - 2 + fvgExtendBars, high[2],
         bgcolor=fvgBullFill, border_color=fvgBullBorder)
    array.push(fvgBullBoxes, b)
    if array.size(fvgBullBoxes) > fvgMaxActive
        box.delete(array.shift(fvgBullBoxes))

if fvgShowBear and bearFVG
    b = box.new(bar_index - 2, low[2], bar_index - 2 + fvgExtendBars, high,
         bgcolor=fvgBearFill, border_color=fvgBearBorder)
    array.push(fvgBearBoxes, b)
    if array.size(fvgBearBoxes) > fvgMaxActive
        box.delete(array.shift(fvgBearBoxes))

if fvgDeleteFill
    if array.size(fvgBullBoxes) > 0
        for i = array.size(fvgBullBoxes) - 1 to 0
            b   = array.get(fvgBullBoxes, i)
            bot = box.get_bottom(b)
            if low <= bot
                box.delete(b)
                array.remove(fvgBullBoxes, i)
    if array.size(fvgBearBoxes) > 0
        for i = array.size(fvgBearBoxes) - 1 to 0
            b   = array.get(fvgBearBoxes, i)
            top = box.get_top(b)
            if high >= top
                box.delete(b)
                array.remove(fvgBearBoxes, i)

fvgState =
     bullFVG and not bearFVG ? "BULL" :
     bearFVG and not bullFVG ? "BEAR" :
     bullFVG and bearFVG     ? "BOTH" : "--"

fvgDashColor =
     bullFVG and not bearFVG ? color.lime   :
     bearFVG and not bullFVG ? color.red    :
     bullFVG and bearFVG     ? color.orange : color.gray


// ============================================================
//  SECTION 9 — RSI STATE CLASSIFICATION
// ============================================================
rsiValue = ta.rsi(close, rsiLen)

rsiState =
     rsiValue >= rsiOBLevel  ? "OB"   :
     rsiValue >  rsiBullZone ? "BULL" :
     rsiValue <  rsiOSLevel  ? "OS"   :
     rsiValue <  rsiBearZone ? "BEAR" :
     "NEUT"

rsiStateColor =
     rsiState == "OB"   ? color.purple :
     rsiState == "BULL" ? color.green  :
     rsiState == "OS"   ? color.aqua   :
     rsiState == "BEAR" ? color.red    :
     color.gray

rsiMomDelta = rsiValue - rsiValue[3]
rsiMomText  = rsiMomDelta >  1.5 ? "↑ RISING"  :
              rsiMomDelta < -1.5 ? "↓ FALLING" : "→ FLAT"
rsiMomColor = rsiMomDelta >  1.5 ? color.green :
              rsiMomDelta < -1.5 ? color.red   : color.gray

priceDelta5 = close    - close[5]
rsiDelta5   = rsiValue - rsiValue[5]
rsiBullDiv  = priceDelta5 < 0 and rsiDelta5 > 0
rsiBearDiv  = priceDelta5 > 0 and rsiDelta5 < 0
rsiDivText  = rsiBullDiv ? "BULL DIV" : rsiBearDiv ? "BEAR DIV" : "--"
rsiDivColor = rsiBullDiv ? color.green : rsiBearDiv ? color.red : color.gray


// ============================================================
//  SECTION 10 — MACD STATE CLASSIFICATION
// ============================================================
[macdLineVal, macdSigVal, macdHistVal] = ta.macd(close, macdFastLen, macdSlowLen, macdSigLen)

macdAboveZero = macdLineVal > 0
macdBelowZero = macdLineVal < 0

macdBullCross = ta.crossover(macdLineVal,  macdSigVal)
macdBearCross = ta.crossunder(macdLineVal, macdSigVal)

histPrev     = macdHistVal[1]
histExpBull  = macdHistVal > 0 and macdHistVal > histPrev
histContBull = macdHistVal > 0 and macdHistVal < histPrev
histExpBear  = macdHistVal < 0 and macdHistVal < histPrev
histContBear = macdHistVal < 0 and macdHistVal > histPrev

macdState =
     macdAboveZero and histExpBull  ? "BULL +" :
     macdAboveZero and histContBull ? "BULL -" :
     macdBelowZero and histExpBear  ? "BEAR +" :
     macdBelowZero and histContBear ? "BEAR -" :
     macdAboveZero                  ? "BULL"   :
     macdBelowZero                  ? "BEAR"   :
     "FLAT"

macdStateColor =
     macdState == "BULL +" ? color.new(color.green, 0)  :
